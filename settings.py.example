# Hyperliquid Bot Settings — пример. Скопируйте в settings.py:
#   cp settings.py.example settings.py
version = "1.4.0"

# Risk Management
SPOT_TOKEN = "BTC"  # Spot Trading token

# --- GridRB 80/20 (активный алгоритм, modules/gridrb_strategy.py) ---
GRIDRB_F0 = 0.80            # целевая доля BTC в портфеле
GRIDRB_BAND = 0.04          # полуширина полосы бездействия (±4 п.п.)
GRIDRB_DELTA = 0.004        # шаг лестниц и микро-сетки (0.4% цены)
GRIDRB_LEVELS = 5           # число уровней в лестнице
GRIDRB_MICRO_LOT = 0.02     # лот микро-сетки (2% от капитала)
GRIDRB_MICRO_MAX = 3        # максимум одновременных микро-ордеров
GRIDRB_MIN_NOTIONAL = 10.0  # минимальный нотионал ордера, USDC
GRIDRB_POLL_INTERVAL = 60   # пауза между итерациями, сек
GRIDRB_MARKET_SLIP = 0.01   # буфер цены для маркет-бутстрапа (1%)
GRIDRB_DRY_RUN = False      # True — только логировать действия, не торговать

# CSV и Telegram
GRIDRB_EVENTS_CSV = "gridrb_events.csv"   # журнал событий (ордера, исполнения)
GRIDRB_STATE_CSV = "gridrb_state.csv"     # периодический снимок состояния
GRIDRB_STATE_CSV_EVERY = 10               # писать state раз в N итераций
GRIDRB_TG_NOTIFY = True                   # отправлять события в Telegram
GRIDRB_TG_CANCELS = False                 # слать ли отмены (обычно шумно)

# --- Старые параметры (оставлены для совместимости модулей/тестов) ---
POSITION_SIZE_PERCENT = 5  # Размер открываемой позиции в % от баланса
STEP = 200  # Шаг сетки (TP) в долларах для усреднения
AGGR = 0.5  # Коэффициент агрессивности торговли (0.1 - 1.0)

# Режим дежурства (docs/project_description.md §6.5). Рантайм его больше не
# использует; оставлен для совместимости старых модулей и тестов.
DUTY_MODE = "parse"

# Hyperliquid API Configuration
HYPERLIQUID_BASE_URL = "https://api.hyperliquid.xyz"        # Основной API
HYPERLIQUID_TESTNET_URL = "https://api.hyperliquid-testnet.xyz"  # Тестовая сеть

# Threading
THREADS = 3  # Количество одновременных потоков

# Database Settings (не используются: персистентность — JSON в databases/ + hype_stat.xlsx)
DB_HOST = "localhost"
DB_PORT = 5432
DB_NAME = "hyperliquid_bot"
DB_USER = "postgres"
DB_PASSWORD = "password"

# Proxy Settings (ОПЦИОНАЛЬНО)
USE_PROXY = False
PROXY_LIST = []

# Hyperliquid Specific Settings
HYPERLIQUID_CHAIN_ID = 42161  # Arbitrum One (mainnet)
HYPERLIQUID_TESTNET_CHAIN_ID = 421614  # Arbitrum Sepolia (testnet)

# Logging
LOG_LEVEL = "DEBUG"
LOG_FILE = "hyperliquid_bot.log"
LOG_ROTATION = "1 day"
LOG_RETENTION = "7 days"
ENABLE_DEBUG_LOGS = True
